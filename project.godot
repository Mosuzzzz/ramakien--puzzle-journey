; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ramakien_Puzzle_Journey"
run/main_scene="res://scenes/homepage/home_page.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://scenes/ui/settings.gd"
Dialogue="*res://scenes/ui/dialogue_manager.tscn"
Quest="*res://scenes/ui/quest_log.tscn"
PauseMenu="*res://scenes/ui/pause_menu.tscn"
Inv="*res://scenes/ui/inventory.tscn"
SaveSlots="*res://scenes/ui/save_slots.tscn"
Tutorial="*res://scenes/ui/tutorial.tscn"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
mouse_cursor/custom_image="res://assets/cursor/cursor_arrow.png"
mouse_cursor/custom_image_hotspot=Vector2(3, 3)

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
