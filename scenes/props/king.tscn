[node name="Talkable" parent="." instance=ExtResource("3_talkable")]
position = Vector2(0, 40)
speaker_name = "ท้าวทศรถ"
lines = Array[String](["พระราม... ลูกรักของพ่อ เข้ามาใกล้ ๆ เถิด สิ่งที่พ่อจะพูดต่อไปนี้ ทำให้ใจพ่อสลายเป็นเสี่ยง ๆ", "เมื่อครู่นางไกยเกษีมาทวงสัญญาเก่าที่พ่อเคยให้ไว้สองประการ ก่อนพิธีอภิเษกของลูกจะเริ่มขึ้นเสียอีก", "นางขอให้พระพรตได้ขึ้นครองราชย์แทนลูก และขอให้ลูกออกจากกรุงไปใช้ชีวิตเป็นฤาษีในป่าเป็นเวลาสิบสี่ปี", "พ่อเป็นกษัตริย์ จะผิดคำสัตย์ไม่ได้... ลูกจะให้อภัยพ่อได้ไหม"])
prompt_offset = Vector2(-90, -160)
flag_after = "chapter_1_audience_done"
quest_after = "ออกเดินทางสู่ป่า"
quest_after_detail = "กลับไปที่ลานวัง แล้วออกทางประตูทิศใต้ของกรุงอโยธยาเพื่อเริ่มการเดินทาง"
narration_after = Array[String](["พระรามรับฟังพระบัญชาด้วยใจสงบ มิได้แสดงความโกรธหรือขัดขืนแต่อย่างใด", "เพราะท่านเชื่อว่า การรักษาคำสัตย์ของกษัตริย์สำคัญยิ่งกว่าความสุขส่วนตน", "ก่อนจากกัน ท้าวทศรถกระซิบบอกเส้นทางลับผ่านป่าใหญ่ที่เคยใช้เสด็จล่าในอดีต ซึ่งจะช่วยย่นระยะทางและเลี่ยงอันตรายได้บ้าง"])
narration_after_title = "คำสั่งเนรเทศ"
